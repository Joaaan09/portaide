# ================================================================
# PortaIDE — server/.env (DESARROLLO local en el host)
# ================================================================
# Copia este archivo a server/.env y ajusta valores. El .env real
# NUNCA se commitea. En producción las variables las pone el compose.

# Puerto HTTP del backend (4100: libre en este VPS; 3000/3900/4000/5000 ocupados)
PORT=4100

NODE_ENV=development

# MongoDB — OPCIONAL en dev: sin ella la app arranca igual (sin persistencia).
# El mongo de PortaIDE se publica en el loopback del host en 27018
# (27017 ya lo ocupa smartpeak-mongo).
# MONGODB_URI=mongodb://127.0.0.1:27018/portaide

# --- Autenticación (CLAUDE.md §11) --------------------------------
# Secreto de firma del JWT de sesión. OBLIGATORIO en producción.
SESSION_SECRET=
# Credenciales del usuario único autorizado (login por email + contraseña).
AUTH_EMAIL=
AUTH_PASSWORD=
# Cookie de sesión: Secure=true requiere HTTPS (en dev por http déjalo en false).
# Por defecto = (NODE_ENV === 'production').
COOKIE_SECURE=false

# --- Filesystem ---------------------------------------------------
# Raíz navegable / workspace por defecto.
FS_ROOT=/home/kuoyii/servers

# --- Notificaciones Web Push (VAPID) — OPCIONAL en dev -------------
# Sin las tres, el push queda DESACTIVADO y el servidor arranca igual (lo dice en
# el log). Genera el par con:  npx web-push generate-vapid-keys
# OJO: el navegador solo registra Service Workers en contexto seguro
# (https o localhost), así que en dev por IP del host no habrá push.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-email@ejemplo.com
#
# Retardo del aviso "sigue trabajando" (ms; default 20000, mínimo 1000).
# PUSH_WORKING_DELAY_MS=20000
