# ================================================================
# PortaIDE — Variables para docker-compose (PRODUCCIÓN)
# ================================================================
# Copia este archivo a `.env` EN EL SERVIDOR y rellena los valores.
# El `.env` real NUNCA se commitea (está en .gitignore).
#
# Genera secretos seguros con:
#   openssl rand -hex 32

# ----- Sesión (firma del JWT en la cookie httpOnly) -----
# Rotar este valor invalida todas las sesiones abiertas.
SESSION_SECRET=genera-uno-con-openssl-rand-hex-48

# ----- Usuario único de la app (login por email + contraseña) -----
# La contraseña se hashea en memoria al arrancar; nunca se envía al cliente
# ni se guarda en claro fuera de este .env (que está en el servidor y gitignored).
AUTH_EMAIL=tu-email@ejemplo.com
AUTH_PASSWORD=una-contraseña-fuerte

# ----- Notificaciones Web Push (VAPID) -----
# Avisos al móvil de "Claude sigue trabajando" / "Claude ha terminado" con la app
# cerrada. Si falta cualquiera de las tres, el push queda DESACTIVADO (el servidor
# arranca igual y lo dice en el log).
#
# Genera el par UNA vez y guárdalo (rotarlo invalida todas las suscripciones ya
# registradas: habría que volver a activar las notificaciones desde Settings):
#   cd server && npx web-push generate-vapid-keys
#
# OJO iOS: Safari solo entrega push si la PWA está AÑADIDA A LA PANTALLA DE INICIO
# (iOS 16.4+). En una pestaña normal de Safari no llega nada.
VAPID_PUBLIC_KEY=pega-aqui-la-clave-publica-generada
VAPID_PRIVATE_KEY=pega-aqui-la-clave-privada-generada
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# ----- Opcional: retardo del aviso "sigue trabajando" -----
# Al irse el usuario con un turno vivo se espera este tiempo antes de avisar, para
# que un microcorte de red o una reconexión rápida no hagan vibrar el móvil
# (ms; default 20000 = 20 s, mínimo 1000).
# PUSH_WORKING_DELAY_MS=20000

# ----- Opcional: concurrencia de turnos de chat -----
# Máximo de sesiones de chat trabajando A LA VEZ. 0 = sin límite; default 3.
# OJO: este VPS se congela por saturación de CPU con varias sesiones de Claude
# a la vez (ver .progreso/decisiones.md). Sube esto bajo tu propio riesgo.
# CHAT_MAX_CONCURRENT_TURNS=3

# ----- Opcional: sesiones de terminal (pty) -----
# Las terminales SOBREVIVEN a la caída del WebSocket (móvil bloqueado, cambio de
# vista): el pty vive en el servidor y el socket solo se engancha y desengancha.
#
# Salida que guarda cada terminal en memoria para repintarla al reengancharse
# (bytes; default 262144 = 256 KiB). Súbelo si pierdes scrollback en builds largos.
# TERMINAL_SCROLLBACK_BYTES=262144
#
# Cuánto sobrevive una terminal SIN nadie mirando antes de que se mate su pty
# (ms; default 7200000 = 2h). Generoso a propósito: permite dejar tareas largas
# corriendo con el móvil apagado. Mismo plazo para conservar la salida final de
# una sesión que murió sin que la vieras.
# TERMINAL_ORPHAN_TTL_MS=7200000
#
# Máximo de terminales vivas a la vez (default 6). Tope defensivo: este VPS se
# congela por saturación de CPU (ver .progreso/decisiones.md).
# TERMINAL_MAX_SESSIONS=6

# ----- Opcional: raíz del filesystem que ve la app -----
# Por defecto /home/kuoyii/servers (todos los proyectos). Amplíalo (p.ej. /home/kuoyii)
# solo si sabes lo que expones y añades el bind-mount correspondiente en el compose.
# FS_ROOT=/home/kuoyii/servers

# ----- Opcional: ruta del fichero SQLite (persistencia) -----
# En dev local, por defecto es ./data/portaide.db resuelto desde el cwd del server.
# En el modelo "backend en el host" (systemd) el unit lo fija a
# /home/kuoyii/servers/portaide/data/portaide.db (ver deploy/portaide-backend.service).
# SQLITE_PATH=/home/kuoyii/servers/portaide/data/portaide.db

# ----- Opcional: interfaz de escucha del backend -----
# Solo relevante con el backend en el HOST (systemd): el contenedor del frontend lo
# alcanza por host.docker.internal, así que debe escuchar en una interfaz visible
# desde ahí (default 0.0.0.0). El unit ya lo fija; cierra el 4100 al exterior con
# UFW (ver deploy/README.md, paso 1). En Docker no hacía falta.
# HOST=0.0.0.0
